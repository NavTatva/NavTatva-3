# ==============================================================================
# NavTatva .gitignore
# Rules for Python, ML models, geospatial/SAR datasets, secrets, IDEs, and OS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Bytecode, Runtime & Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
*.dll

# ------------------------------------------------------------------------------
# 2. Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. Testing, Linting & Type Checking
# ------------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------------------------
# 4. Packaging, Builds & Distributions
# ------------------------------------------------------------------------------
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/

# ------------------------------------------------------------------------------
# 5. Jupyter Notebooks (Editor checkpoints)
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb

# ------------------------------------------------------------------------------
# 6. Credentials, Tokens, Keys & Environment Files
# Credentials must NEVER be committed. tests/test_offline_boundary.py also scans
# for token-shaped strings, but gitignore is the essential frontline defence.
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.token
access_token
kaggle.json
.huggingface/
.copernicusmarine/
copernicusmarine.json
.netrc
_netrc
aisstream.key
*.key
*.pem
*.crt
*.cer
*.der
*.pfx
*.p12
*.keystore
secrets.json
secret*.json
credentials.json
client_secret*.json
*.secret
id_rsa*
id_ed25519*

# ------------------------------------------------------------------------------
# 7. IDEs, Editors & AI Assistants
# ------------------------------------------------------------------------------
.vscode/
.idea/
.cursor/
.claude/
.gemini/
.agents/
*.code-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 8. Operating System Metadata
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump

# Linux
.fuse_hidden*
.directory

# Spec sheet, scratch and Office lock files
p2.docx
~$*.doc*
~$*.xls*
~$*.ppt*

# ------------------------------------------------------------------------------
# 9. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
*.orig
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
node_modules/

# ------------------------------------------------------------------------------
# 10. NavTatva Geospatial Data & Metocean Grids
# Heavy observation data is fetched or generated by scripts; not tracked in git.
# ------------------------------------------------------------------------------
# SAR satellite imagery & raw archives
data/sar/*.tif
data/sar/*.tiff
data/sar/*.geotiff
data/sar/*.jp2
data/sar/*.tar.gz
data/sar/*.zip
data/sar/*.SAFE
data/sar/raw/
!data/sar/scenes.json

# Metocean datasets (ERA5, Copernicus Marine, HYCOM grids)
data/metocean/*.npz
data/metocean/*.nc
data/metocean/*.grib*
data/metocean/*.grb*

# AIS datasets and database stores (keep ground-truth JSON benchmarks)
data/ais/*.sqlite*
data/ais/*.db*
data/ais/*.csv
data/ais/*.parquet
data/ais/live.*
!data/ais/ground_truth_*.json

# Job execution artifacts, run audits and cached overlays
data/jobs/*.json
data/jobs/*.part
data/jobs/*.tmp
data/cache/
data/zenodo/
data/tiles/
data/basemap/

# Land masks (rebuilt locally by scripts/build_land_mask.py)
data/land/

# Optical corroboration chips (small metadata JSON manifests are tracked)
data/optical/*.png
data/optical/*.jpg
data/optical/*.jpeg
data/optical/*.webp
data/optical/*.tif
data/optical/*.tiff
!data/optical/*.json

# Heavy downloaded raw archives in data tree
data/**/*.zip
data/**/*.tar
data/**/*.tar.gz
data/**/*.tgz
data/**/*.7z

# ------------------------------------------------------------------------------
# 11. Machine Learning Model Weights & Checkpoints
# Local model weights are kept on disk or synced with HuggingFace Hub via scripts.
# Audit reports (*.report.json) and READMEs are tracked.
# ------------------------------------------------------------------------------
models/*.pt
models/*.pth
models/*.onnx
models/*.safetensors
models/*.bin
models/*.ckpt
models/*.h5
models/*.pkl
models/*.joblib
models/quarantine/*.pt
models/quarantine/*.pth
!models/*.report.json
!models/**/*.report.json
!models/**/README.md

# Vercel build output (generated by build.js, never commit)
dist/

# =============================================================================
# NavTatva / TideTrace — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# The app reads EVERY setting from these variables — nothing is hardcoded.
#
# Local dev : python-dotenv loads .env automatically when uvicorn starts.
# Render    : paste each variable into the "Environment" panel of your service.
# Vercel    : paste each variable into Project → Settings → Environment Variables.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — API routing
# -----------------------------------------------------------------------------
# URL the browser (and Vercel's /api proxy) uses to reach the backend.
#   Local  : http://localhost:8000
#   Render : https://your-service-name.onrender.com   ← fill in after deploy
API_BASE_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# REQUIRED — Backend behaviour
# -----------------------------------------------------------------------------
# Run without live metocean / satellite data (safe default for demos).
TIDETRACE_OFFLINE=1


# -----------------------------------------------------------------------------
# OPTIONAL — Live AIS (real-time vessel tracking)
# Get a free key at https://aisstream.io
# Leave blank to disable live AIS; the demo scenes still work without it.
# -----------------------------------------------------------------------------
AISSTREAM_API_KEY=


# -----------------------------------------------------------------------------
# OPTIONAL — Hugging Face model download
# Get a free token at https://huggingface.co/settings/tokens
# Only needed if you want the app to auto-download the U-Net checkpoint.
# -----------------------------------------------------------------------------
HF_TOKEN=


# -----------------------------------------------------------------------------
# OPTIONAL — Drift physics  (defaults match the SIH26143 spec sheet)
# Uncomment and change only if you know what you are adjusting.
# -----------------------------------------------------------------------------
# TIDETRACE_ALPHA_WIND=0.03          # wind-drift fraction (3 %)
# TIDETRACE_DEFLECTION_DEG=15        # right-of-wind deflection, N hemisphere
# TIDETRACE_ENSEMBLE_N=50            # Monte-Carlo ensemble size
# TIDETRACE_DT_SECONDS=3600          # time-step (1 h)
# TIDETRACE_HINDCAST_H=48            # hindcast window (hours)
# TIDETRACE_FORECAST_H=36            # forecast window (hours)
# TIDETRACE_SEARCH_RADIUS_KM=10      # AIS search radius
# TIDETRACE_ORIGIN_WINDOW_H=3        # spill-origin time window


# -----------------------------------------------------------------------------
# OPTIONAL — Detection post-processing
# -----------------------------------------------------------------------------
# TIDETRACE_OIL_DB_THRESHOLD=-22.0
# TIDETRACE_MIN_OIL_AREA_KM2=0.05
# TIDETRACE_MIN_OIL_PIXELS=500
# TIDETRACE_TILE=512
# TIDETRACE_TILE_OVERLAP=64


# -----------------------------------------------------------------------------
# OPTIONAL — Scoring weights  (must sum to 1.0)
# -----------------------------------------------------------------------------
# TIDETRACE_W_PROX=0.30
# TIDETRACE_W_TIME=0.20
# TIDETRACE_W_BEH=0.25
# TIDETRACE_W_TYPE=0.15
# TIDETRACE_W_TRAJ=0.10


# -----------------------------------------------------------------------------
# OPTIONAL — System / demo flags
# -----------------------------------------------------------------------------
# TIDETRACE_KEEP_JOBS=200            # max stored job documents
# TIDETRACE_KEEP_JOB_OVERLAYS=20     # max stored overlay PNGs
# TIDETRACE_SEED=20260920            # deterministic RNG seed
# TIDETRACE_OPEN_METEO_LIVE=0        # fetch live wind from open-meteo.com
# TIDETRACE_DEMO_METOCEAN=0          # show "demo metocean" badge in UI
# TIDETRACE_ALLOW_SELFTEST_SCENES=0  # expose synthetic self-test scenes
# TIDETRACE_RADIOMETRIC_ALIGN=0      # radiometric bias correction (expert)

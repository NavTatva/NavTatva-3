# Environment Variables for NavTatva

# Backend API URL (replace with your Render backend URL after deployment)
VITE_API_URL=http://localhost:8000

# For production (Vercel frontend)
# VITE_API_URL=https://your-backend-url.onrender.com

# Backend Configuration
TIDETRACE_OFFLINE=1
TIDETRACE_ALPHA_WIND=0.03
TIDETRACE_DEFLECTION_DEG=15
TIDETRACE_ENSEMBLE_N=50
TIDETRACE_DT_SECONDS=3600
TIDETRACE_HINDCAST_H=48
TIDETRACE_FORECAST_H=36
TIDETRACE_SEARCH_RADIUS_KM=10
TIDETRACE_ORIGIN_WINDOW_H=3

# Optional: AIS Stream API Key (for live AIS)
# AISSTREAM_API_KEY=your_key_here

# Optional: Hugging Face Token (for model downloads)
# HF_TOKEN=your_token_here
